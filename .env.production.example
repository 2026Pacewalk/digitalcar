# ── DigitalCarda production .env (server: /var/www/digitalcarda/.env) ──
# Copy this file to ".env" on the server and fill in real values.
# The values marked "(from your local .env)" must be copied verbatim from the
# .env you already use locally — they are your Kimi/Moonshot app credentials.

NODE_ENV=production
PORT=3000

# Server MySQL — create this DB + user first (see DEPLOY.md)
DATABASE_URL=mysql://digitalcarda:STRONG_DB_PASSWORD@127.0.0.1:3306/digitalcarda

# Auth token signing secret — generate a long random string:
#   openssl rand -hex 48
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING

# App credentials (from your local .env)
APP_ID=
APP_SECRET=
VITE_APP_ID=

# Kimi endpoints (from your local .env)
KIMI_AUTH_URL=
KIMI_OPEN_URL=
VITE_KIMI_AUTH_URL=

# Optional
OWNER_UNION_ID=
