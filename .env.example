# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Union ID of the app creator; this user gets role "admin" on first login

# ── Lead-notification email (SMTP) ──────────────────────────────
# When a lead is captured, the owner is emailed. Leave blank to disable.
# Gmail App Password:  SMTP_HOST=smtp.gmail.com  SMTP_PORT=465
#   (Google Account → Security → 2-Step Verification → App passwords)
# Zoho:                SMTP_HOST=smtp.zoho.in    SMTP_PORT=465
SMTP_HOST=                # e.g. smtp.gmail.com
SMTP_PORT=465             # 465 (SSL) or 587 (STARTTLS)
SMTP_USER=                # the account that authenticates, e.g. hello@digitalcarda.in
SMTP_PASS=                # app password (NOT your normal password)
MAIL_FROM=DigitalCarda <hello@digitalcarda.in>   # shown as sender; must be send-as-authorised
LEAD_NOTIFY_TO=hello@digitalcarda.in   # where lead / signup / payout alerts go

# ── Links & scheduled jobs ──────────────────────────────────────
PUBLIC_BASE_URL=https://digitalcarda.in  # used in email links (reset, etc.)
CRON_SECRET=                # secret for POST /api/cron/trial-emails (trial FOMO)

# ── Smart leads (AI classification) ─────────────────────────────
# Optional. Without a key, leads are classified by built-in rules. With a key,
# incoming leads are classified by Claude (important / normal / spam).
ANTHROPIC_API_KEY=          # Anthropic API key (sk-ant-…)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001   # cheap, fast model for classification

# ── Razorpay Standard Checkout (online card/UPI/netbanking payments) ──
# Get keys from Razorpay Dashboard → Settings → API Keys. Use rzp_test_* for
# testing, rzp_live_* in production. KEY_SECRET is backend-only — never expose it.
RAZORPAY_KEY_ID=            # rzp_test_… or rzp_live_…
RAZORPAY_KEY_SECRET=        # backend only — MUST NOT reach the browser
VITE_RAZORPAY_KEY_ID=       # public Key ID for checkout.js (same value as RAZORPAY_KEY_ID)
RAZORPAY_WEBHOOK_SECRET=    # backend only — matches the secret set in Razorpay → Webhooks (payment.captured)
